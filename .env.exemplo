# Copie para .env e preencha. O .env nunca vai para o git.

# Domínio onde a GreenIA vai responder (o DNS precisa apontar para esta máquina).
DOMINIO=ia.suaempresa.com.br

# Email do primeiro admin. Ele entra com código por email e configura o resto no painel.
ADMIN_EMAIL=ti@suaempresa.com.br

# Chave do OpenRouter (openrouter.ai, Settings > API Keys). Obrigatória em produção.
OPENROUTER_API_KEY=

# Plano contratado (opcional). Sem PLANO_CREDITOS, a empresa vê o custo real em dólar e não há cota.
# Com plano, a empresa vê créditos (1 crédito = US$ 0,01 de custo de IA) e só o operador vê dólar.
# PLANO_CREDITOS=25000
# PLANO_RESERVA=5000          # só modelo rápido, depois dos créditos (padrão: 20% do plano)
# PLANO_PRECO_USD=750         # usado só no resumo do operador
# OPERADOR_EMAIL=suporte@suaoperadora.com
# Console do operador (veja o README):
# OPERADOR_TOKEN=             # na instalação de cada cliente: openssl rand -base64 32
# CUSTO_INFRA_USD=7           # custo mensal do servidor, para a margem
# PACOTE_CREDITOS=10000
# PACOTE_PRECO_USD=250
# INSTANCIAS=Cliente A|https://ia.clientea.com.br|token-do-cliente-a    # só na instalação do operador
# PAGINA_INICIAL=vendas       # só na instalação do operador: a raiz abre a página de vendas

# Backup diário (opcional). Hora do servidor, em UTC no contêiner.
BACKUP_HORA=06:00
BACKUP_MANTER=14
# Envio para armazenamento compatível com S3 (opcional):
# BACKUP_DESTINO=s3://nome-do-bucket/greenia
# S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# S3_REGIAO=sa-east-1
# S3_CHAVE=
# S3_SEGREDO=
