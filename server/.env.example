# Variáveis do servidor da GreenIA. Em produção (AWS sa-east-1), os segredos
# vêm do AWS Secrets Manager (ou SSM Parameter Store) injetados no ambiente do
# contêiner; nunca em arquivo versionado.

NODE_ENV=production
PORT=8080
# URL pública do app (redirects do login e checagem de Origin nas escritas).
PUBLIC_URL=https://app.greenia.theneil.com.br

# Postgres (Amazon RDS for PostgreSQL 16, sa-east-1, com pgvector e criptografia em repouso).
# Servidor: papel sem BYPASSRLS, membro de greenia_app (criado pelo migrador).
DATABASE_URL=postgres://greenia_srv:SENHA@greenia.xxxx.sa-east-1.rds.amazonaws.com:5432/greenia?sslmode=require
# Dono das tabelas: migrações e operações de plataforma (criar tenant).
DATABASE_OWNER_URL=postgres://greenia_owner:SENHA@greenia.xxxx.sa-east-1.rds.amazonaws.com:5432/greenia?sslmode=require
# Usados só pelo migrador para criar/atualizar o papel do servidor.
APP_DB_USER=greenia_srv
APP_DB_PASSWORD=

# Redis (Amazon ElastiCache, sa-east-1, com TLS): fila e limite de requisições.
REDIS_URL=rediss://master.greenia.xxxx.sae1.cache.amazonaws.com:6379

# Documentos (Amazon S3, sa-east-1). Credenciais pela role da tarefa (sem chave fixa).
S3_REGION=sa-east-1
S3_BUCKET=greenia-documentos-prod
S3_SSE=aws:kms
S3_KMS_KEY_ID=arn:aws:kms:sa-east-1:ACCOUNT:key/KEY-ID
S3_FORCE_PATH_STYLE=false
# S3_ENDPOINT fica vazio na AWS; preenchido só para MinIO.
S3_ENDPOINT=

# Email (Amazon SES em sa-east-1, pela interface SMTP). Ver SPF/DKIM/DMARC no README.
SMTP_URL=smtps://USUARIO_SMTP:SENHA_SMTP@email-smtp.sa-east-1.amazonaws.com:465
EMAIL_FROM=GreenIA <nao-responda@greenia.theneil.com.br>

# Modelo (API da Anthropic). Obrigatória em produção.
ANTHROPIC_API_KEY=
# Câmbio para o custo em reais.
USD_BRL=5.5

# Segredos dos provedores OIDC: a configuração do tenant guarda só o NOME da
# variável (clientSecretEnv); o valor fica aqui.
# OIDC_REPET_ENTRA_SECRET=

SESSION_TTL_HOURS=12
COOKIE_SECURE=true
KB_UPLOAD_BODY_LIMIT_MB=30
LOG_LEVEL=info
