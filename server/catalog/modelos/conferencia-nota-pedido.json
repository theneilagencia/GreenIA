{
  "kind": "assistente",
  "slug": "conferencia-nota-pedido",
  "version": 2,
  "name": "Conferência de nota fiscal de entrada × pedido de compra",
  "description": "Confere a NF-e de entrada (XML) contra o pedido de compra exportado do sistema de compras e lista as divergências. O pedido entra por um mapeamento de importação do cliente (CSV, XLSX, texto de largura fixa, JSON ou XML).",
  "areaSugerida": "Compras, fiscal ou recebimento",
  "leitores": [
    "nfe",
    "danfe"
  ],
  "definition": {
    "description": "Confere a NF-e de entrada (XML) contra o pedido de compra exportado do sistema de compras e lista as divergências. O pedido entra por um mapeamento de importação do cliente (CSV, XLSX, texto de largura fixa, JSON ou XML).",
    "objective": "Encontrar divergências de quantidade, preço, descrição e cabeçalho antes do lançamento da nota.",
    "instructions": "",
    "inputs": {
      "text": {
        "enabled": false
      },
      "files": {
        "enabled": true,
        "required": true,
        "accept": [
          "nfe_xml",
          "pdf",
          "xlsx",
          "csv",
          "texto"
        ],
        "maxFiles": 10,
        "maxFileMb": 10
      }
    },
    "dados": [
      {
        "id": "pedido",
        "nome": "Pedido de compra",
        "campos": [
          {
            "campo": "pedido",
            "nome": "Número do pedido",
            "tipo": "texto"
          },
          {
            "campo": "cnpjFornecedor",
            "nome": "CNPJ do fornecedor",
            "tipo": "texto"
          },
          {
            "campo": "dataPedido",
            "nome": "Data do pedido",
            "tipo": "data"
          },
          {
            "campo": "totalPedido",
            "nome": "Valor total do pedido",
            "tipo": "numero",
            "obrigatorio": false
          },
          {
            "campo": "codigo",
            "nome": "Código do item",
            "tipo": "texto"
          },
          {
            "campo": "descricao",
            "nome": "Descrição",
            "tipo": "texto"
          },
          {
            "campo": "quantidade",
            "nome": "Quantidade",
            "tipo": "numero"
          },
          {
            "campo": "unidade",
            "nome": "Unidade",
            "tipo": "texto",
            "obrigatorio": false
          },
          {
            "campo": "valorUnitario",
            "nome": "Valor unitário",
            "tipo": "numero"
          },
          {
            "campo": "valorTotal",
            "nome": "Valor total do item",
            "tipo": "numero",
            "obrigatorio": false
          }
        ]
      }
    ],
    "dataClasses": [
      "verde",
      "amarela"
    ],
    "dataPolicy": {
      "cnpj": "permitir_com_registro",
      "nome": "permitir_com_registro",
      "endereco": "permitir_com_registro",
      "cep": "permitir_com_registro"
    },
    "retention": {
      "days": 365
    },
    "pipeline": [
      {
        "bloco": "ler",
        "params": {
          "visao": "nunca"
        }
      },
      {
        "bloco": "conferir",
        "id": "itens",
        "titulo": "Itens da nota × itens do pedido",
        "params": {
          "esquerda": {
            "de": "nfe",
            "caminho": "itens"
          },
          "direita": {
            "de": "importacao",
            "conjunto": "pedido"
          },
          "rotulos": {
            "esquerda": "Nota",
            "direita": "Pedido"
          },
          "chave": {
            "esquerda": "codigo",
            "direita": "codigo"
          },
          "regras": [
            {
              "campo": "Quantidade",
              "esquerda": "quantidade",
              "direita": "quantidade",
              "tipo": "numero"
            },
            {
              "campo": "Valor unitário",
              "esquerda": "valorUnitario",
              "direita": "valorUnitario",
              "tipo": "numero",
              "tolerancia": {
                "percentual": 1
              }
            },
            {
              "campo": "Descrição",
              "esquerda": "descricao",
              "direita": "descricao",
              "tipo": "texto"
            }
          ]
        }
      },
      {
        "bloco": "conferir",
        "id": "cabecalho",
        "titulo": "Cabeçalho da nota × cabeçalho do pedido",
        "params": {
          "esquerda": {
            "de": "nfe"
          },
          "direita": {
            "de": "importacao",
            "conjunto": "pedido",
            "registro": "primeiro"
          },
          "rotulos": {
            "esquerda": "Nota",
            "direita": "Pedido"
          },
          "regras": [
            {
              "campo": "Número do pedido",
              "esquerda": "pedido",
              "direita": "pedido",
              "tipo": "igual"
            },
            {
              "campo": "CNPJ do fornecedor",
              "esquerda": "emitente.cnpj",
              "direita": "cnpjFornecedor",
              "tipo": "igual"
            },
            {
              "campo": "Emissão dentro do prazo de entrega",
              "esquerda": "dataEmissao",
              "direita": "dataPedido",
              "tipo": "data",
              "prazoDias": 30,
              "referencia": "direita"
            },
            {
              "campo": "Valor total",
              "esquerda": "totais.nota",
              "direita": "totalPedido",
              "tipo": "numero",
              "tolerancia": {
                "absoluta": 1
              }
            }
          ]
        }
      },
      {
        "bloco": "exportar",
        "params": {
          "formatos": [
            "xlsx",
            "pdf",
            "csv"
          ]
        }
      }
    ],
    "output": {
      "format": "tabela",
      "files": [
        "xlsx",
        "pdf",
        "csv"
      ]
    },
    "review": {
      "reviewers": [
        "key_user",
        "revisor"
      ],
      "checklist": [
        "Itens sem par no pedido foram confirmados com o comprador.",
        "Divergências de preço dentro do acordo comercial foram descartadas com justificativa."
      ]
    }
  }
}
