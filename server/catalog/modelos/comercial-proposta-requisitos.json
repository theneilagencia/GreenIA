{
  "kind": "assistente",
  "slug": "comercial-proposta-requisitos",
  "version": 2,
  "name": "Proposta recebida × requisitos",
  "description": "Confere se uma proposta de cliente ou de parceiro atende à lista de requisitos e resume o que foi pedido.",
  "areaSugerida": "Comercial ou vendas",
  "leitores": [],
  "definition": {
    "description": "Confere se uma proposta recebida atende à lista de requisitos e resume o que foi pedido.",
    "objective": "Responder mais rápido a propostas e não esquecer requisito obrigatório.",
    "instructions": "Use só o que está nos documentos. Requisito que não aparece fica como ausente ou duvidoso, nunca presumido.",
    "inputs": {
      "text": {
        "enabled": true,
        "required": false,
        "label": "Observações sobre a proposta"
      },
      "files": {
        "enabled": true,
        "required": true,
        "accept": [
          "pdf",
          "docx",
          "xlsx",
          "imagem"
        ],
        "maxFiles": 10
      }
    },
    "dataClasses": [
      "verde",
      "amarela"
    ],
    "dataPolicy": {
      "cnpj": "permitir_com_registro",
      "email": "permitir_com_registro",
      "telefone": "permitir_com_registro",
      "nome": "permitir_com_registro"
    },
    "retention": {
      "days": 180
    },
    "pipeline": [
      {
        "bloco": "ler"
      },
      {
        "bloco": "checklist",
        "titulo": "Requisitos da proposta",
        "params": {
          "metodo": "regras",
          "itens": [
            {
              "id": "escopo",
              "nome": "Escopo descrito",
              "sinonimos": [
                "objeto",
                "escopo do serviço",
                "descrição do fornecimento",
                "escopo",
                "objeto da proposta"
              ],
              "evidencia": "mencao"
            },
            {
              "id": "prazo",
              "nome": "Prazo de entrega ou execução",
              "sinonimos": [
                "prazo de entrega",
                "cronograma",
                "prazo de execução",
                "prazo de implantação",
                "prazo"
              ],
              "evidencia": "mencao"
            },
            {
              "id": "preco",
              "nome": "Preço e condições de pagamento",
              "sinonimos": [
                "valor total",
                "condições de pagamento",
                "forma de pagamento",
                "preço",
                "investimento",
                "valor da proposta"
              ],
              "evidencia": "mencao"
            },
            {
              "id": "validade",
              "nome": "Validade da proposta",
              "sinonimos": [
                "proposta válida",
                "validade",
                "validade da proposta",
                "proposta válida por"
              ],
              "evidencia": "mencao"
            },
            {
              "id": "garantia",
              "nome": "Garantia",
              "sinonimos": [
                "garantia de",
                "prazo de garantia",
                "período de garantia"
              ],
              "obrigatorio": false,
              "evidencia": "mencao"
            },
            {
              "id": "sla",
              "nome": "Nível de serviço (SLA)",
              "sinonimos": [
                "nível de serviço",
                "acordo de nível de serviço",
                "SLA",
                "tempo de resposta",
                "tempo de atendimento"
              ],
              "obrigatorio": false,
              "evidencia": "mencao"
            }
          ]
        }
      },
      {
        "bloco": "resumir",
        "titulo": "Resumo da proposta",
        "params": {
          "topicos": [
            "O que foi pedido",
            "Prazos",
            "Valores e condições",
            "Requisitos que faltam",
            "Perguntas para o cliente"
          ],
          "palavrasMax": 400
        }
      },
      {
        "bloco": "exportar",
        "params": {
          "formatos": [
            "docx",
            "pdf"
          ]
        }
      }
    ],
    "output": {
      "format": "checklist",
      "files": [
        "docx",
        "pdf"
      ]
    },
    "review": {
      "reviewers": [
        "key_user",
        "revisor"
      ],
      "checklist": [
        "Cada requisito ausente foi conferido na proposta."
      ]
    }
  }
}
