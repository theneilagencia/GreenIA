{
  "slug": "checklist-admissao",
  "name": "Checklist de documentos de admissão",
  "area": "rh",
  "status": "piloto",
  "definition": {
    "description": "Confere a pasta de documentos de uma admissão e aponta o que está presente, ausente ou duvidoso.",
    "owner": "key.rh@demonstracao.com.br",
    "objective": "Identificar documentos pendentes antes do cadastro no eSocial.",
    "inputs": {
      "text": { "enabled": false },
      "files": { "enabled": true, "required": true, "accept": ["pdf", "imagem", "docx"], "maxFiles": 30, "maxFileMb": 15 }
    },
    "dataClasses": ["verde", "amarela", "vermelha"],
    "dataPolicy": { "cpf": "permitir_com_registro", "rg": "permitir_com_registro", "nome": "permitir_com_registro", "endereco": "permitir_com_registro", "cep": "permitir_com_registro", "telefone": "permitir_com_registro", "email": "permitir_com_registro" },
    "retention": { "days": 90 },
    "reading": { "ocrMinConfidence": 70, "visionFallback": true },
    "pipeline": [
      { "bloco": "ler", "params": { "visao": "auto" } },
      { "bloco": "checklist", "titulo": "Documentos da admissão", "params": {
        "metodo": "regras",
        "itens": [
          { "id": "rg", "nome": "RG", "sinonimos": ["carteira de identidade", "registro geral"] },
          { "id": "cpf", "nome": "CPF", "sinonimos": ["cadastro de pessoas físicas"] },
          { "id": "residencia", "nome": "Comprovante de residência", "sinonimos": ["comprovante de endereço", "conta de luz", "conta de água"] },
          { "id": "ctps", "nome": "Carteira de trabalho", "sinonimos": ["CTPS", "carteira de trabalho digital"] },
          { "id": "aso", "nome": "ASO", "sinonimos": ["atestado de saúde ocupacional", "exame admissional"] },
          { "id": "titulo", "nome": "Título de eleitor", "sinonimos": [], "obrigatorio": false },
          { "id": "banco", "nome": "Dados bancários", "sinonimos": ["conta salário", "comprovante bancário"] }
        ]
      } },
      { "bloco": "exportar", "params": { "formatos": ["pdf", "xlsx"] } }
    ],
    "output": { "format": "checklist", "files": ["pdf", "xlsx"] },
    "review": { "reviewers": ["key_user"], "checklist": ["Documentos duvidosos foram abertos e conferidos.", "Pendências foram comunicadas ao candidato."] },
    "metrics": { "indicators": [
      { "key": "tempo_por_admissao", "label": "Tempo de conferência por admissão", "unit": "min", "direction": "menor_melhor", "auto": "tempo_processamento" },
      { "key": "pendencias", "label": "Pendências encontradas por admissão", "unit": "por admissão", "direction": "maior_melhor", "auto": "pendencias" }
    ] }
  }
}
