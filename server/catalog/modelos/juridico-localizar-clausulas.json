{
  "kind": "assistente",
  "slug": "juridico-localizar-clausulas",
  "version": 1,
  "name": "Localizar cláusulas em contratos",
  "description": "Localiza, num conjunto de contratos, as cláusulas de vigência, reajuste, multa, rescisão, confidencialidade e foro, com página e trecho de cada uma.",
  "areaSugerida": "Jurídico ou contratos",
  "leitores": [],
  "definition": {
    "description": "Localiza cláusulas-chave num conjunto de contratos, com página e trecho.",
    "objective": "Montar a planilha de cláusulas sem reler cada contrato.",
    "instructions": "Copie o trecho da cláusula como está no contrato. Se a cláusula não existir, deixe vazio.",
    "inputs": {
      "text": {
        "enabled": false
      },
      "files": {
        "enabled": true,
        "required": true,
        "accept": [
          "pdf",
          "docx",
          "imagem"
        ],
        "maxFiles": 50
      }
    },
    "dataClasses": [
      "verde",
      "amarela"
    ],
    "dataPolicy": {
      "cnpj": "permitir_com_registro",
      "nome": "permitir_com_registro",
      "endereco": "permitir_com_registro"
    },
    "retention": {
      "days": 365
    },
    "pipeline": [
      {
        "bloco": "ler",
        "params": {
          "paginasMax": 150
        }
      },
      {
        "bloco": "extrair",
        "id": "clausulas",
        "titulo": "Cláusulas por contrato",
        "params": {
          "por": "documento",
          "instrucoes": "Para cada cláusula, copie o trecho principal (até 400 caracteres).",
          "schema": {
            "type": "object",
            "properties": {
              "partes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "vigencia": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reajuste": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "multa": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rescisao": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidencialidade": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "foro": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "partes",
              "vigencia",
              "reajuste",
              "multa",
              "rescisao",
              "confidencialidade",
              "foro"
            ]
          }
        }
      },
      {
        "bloco": "exportar",
        "params": {
          "formatos": [
            "xlsx",
            "pdf"
          ]
        }
      }
    ],
    "output": {
      "format": "tabela",
      "files": [
        "xlsx",
        "pdf"
      ]
    },
    "review": {
      "reviewers": [
        "key_user"
      ],
      "checklist": [
        "Cada trecho foi conferido na página indicada."
      ]
    }
  }
}
