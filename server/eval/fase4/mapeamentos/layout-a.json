{
  "nome": "Layout A · CSV com ponto e vírgula em Latin-1, cabeçalho do pedido (número, data, CNPJ e total) nas linhas de título e rodapé de totais",
  "formato": "csv",
  "codificacao": "latin1",
  "separador": ";",
  "ignorarLinhasInicio": 4,
  "ignorarLinhasFim": 0,
  "ignorarLinhasQue": ["^Total geral", "^Registros listados"],
  "linhaCabecalho": true,
  "numero": { "decimal": ",", "milhar": "." },
  "data": "dd/mm/aaaa",
  "campos": [
    { "campo": "pedido", "doTopo": { "padrao": "Pedido nº: (\\d+)" }, "tipo": "texto", "obrigatorio": true },
    { "campo": "dataPedido", "doTopo": { "padrao": "Data do pedido: (\\d{2}/\\d{2}/\\d{4})" }, "tipo": "data", "obrigatorio": true },
    { "campo": "cnpjFornecedor", "doTopo": { "padrao": "CNPJ: ([\\d./-]+)" }, "tipo": "texto", "obrigatorio": true, "transformacoes": [{ "tipo": "somenteDigitos" }] },
    { "campo": "totalPedido", "doTopo": { "padrao": "Valor total do pedido: ([\\d.,]+)" }, "tipo": "numero" },
    { "campo": "codigo", "origem": "Cód. Produto", "tipo": "texto", "obrigatorio": true },
    { "campo": "descricao", "origem": "Descrição", "tipo": "texto", "transformacoes": [{ "tipo": "aparar" }] },
    { "campo": "unidade", "origem": "Un", "tipo": "texto" },
    { "campo": "quantidade", "origem": "Qtde", "tipo": "numero", "obrigatorio": true },
    { "campo": "valorUnitario", "origem": "Vlr. Unit.", "tipo": "numero", "obrigatorio": true },
    { "campo": "valorTotal", "origem": "Vlr. Total", "tipo": "numero" }
  ]
}
