{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/data/**",
              "components/typographic/**",
              "decks/oren_b2b/**",
              "decks/oren_b2b_v1_backup/**",
              "decks/oren_platform/**",
              "ui_kits/deck/**",
              "ui_kits/leave_behind/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: title, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardIt'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|children|compact|className|style|key|ref|className|style|children)$/]",
        "message": "<CardIt> doesn't accept that prop. Declared props: label, title, children, compact, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Eyebrow> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InvestTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:leftHead|rightHead|rows|className|style|key|ref|className|style|children)$/]",
        "message": "<InvestTable> doesn't accept that prop. Declared props: leftHead, rightHead, rows, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrenLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:pillar|size|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<OrenLockup> doesn't accept that prop. Declared props: pillar, size, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrenLockup'] > JSXAttribute[name.name='pillar'] > Literal[value!=/^(?:corp|payments|capital|governance)$/]",
        "message": "<OrenLockup> pillar must be one of 'corp' | 'payments' | 'capital' | 'governance'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrenSymbol'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|watermark|className|style|title|key|ref|className|style|children)$/]",
        "message": "<OrenSymbol> doesn't accept that prop. Declared props: size, tone, watermark, className, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrenSymbol'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:deep|cream|light|payments|capital|governance|gradient|current)$/]",
        "message": "<OrenSymbol> tone must be one of 'deep' | 'cream' | 'light' | 'payments' | 'capital' | 'governance' | 'gradient' | 'current'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|title|children|active|className|style|key|ref|className|style|children)$/]",
        "message": "<PhaseBox> doesn't accept that prop. Declared props: tag, title, children, active, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|source|deck|className|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, source, deck, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|desc|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: n, title, desc."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
