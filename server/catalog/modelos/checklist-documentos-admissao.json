{
  "kind": "assistente",
  "slug": "checklist-documentos-admissao",
  "version": 2,
  "name": "Checklist de documentos de admissão",
  "description": "Confere a pasta de documentos de uma admissão e aponta o que está presente, ausente ou duvidoso.",
  "areaSugerida": "Pessoas (RH, departamento pessoal)",
  "leitores": [],
  "definition": {
    "description": "Confere a pasta de documentos de uma admissão e aponta o que está presente, ausente ou duvidoso.",
    "objective": "Identificar documentos pendentes antes do cadastro no eSocial.",
    "inputs": {
      "text": {
        "enabled": false
      },
      "files": {
        "enabled": true,
        "required": true,
        "accept": [
          "pdf",
          "imagem",
          "docx"
        ],
        "maxFiles": 30,
        "maxFileMb": 15
      }
    },
    "dataClasses": [
      "verde",
      "amarela",
      "vermelha"
    ],
    "dataPolicy": {
      "cpf": "permitir_com_registro",
      "rg": "permitir_com_registro",
      "nome": "permitir_com_registro",
      "endereco": "permitir_com_registro",
      "cep": "permitir_com_registro",
      "telefone": "permitir_com_registro",
      "email": "permitir_com_registro"
    },
    "retention": {
      "days": 90
    },
    "reading": {
      "ocrMinConfidence": 70,
      "visionFallback": true
    },
    "pipeline": [
      {
        "bloco": "ler",
        "params": {
          "visao": "auto"
        }
      },
      {
        "bloco": "checklist",
        "titulo": "Documentos da admissão",
        "params": {
          "metodo": "regras",
          "itens": [
            {
              "id": "rg",
              "nome": "RG",
              "sinonimos": [
                "carteira de identidade",
                "registro geral",
                "cédula de identidade",
                "carteira de identidade nacional",
                "CIN",
                "documento de identidade"
              ]
            },
            {
              "id": "cpf",
              "nome": "CPF",
              "sinonimos": [
                "cadastro de pessoas físicas",
                "comprovante de inscrição no CPF",
                "comprovante de situação cadastral no CPF",
                "cadastro de pessoa física"
              ]
            },
            {
              "id": "residencia",
              "nome": "Comprovante de residência",
              "sinonimos": [
                "comprovante de endereço",
                "conta de luz",
                "conta de água",
                "conta de energia",
                "conta de gás",
                "conta de telefone",
                "fatura de internet",
                "declaração de residência"
              ]
            },
            {
              "id": "ctps",
              "nome": "Carteira de trabalho",
              "sinonimos": [
                "CTPS",
                "carteira de trabalho digital",
                "carteira de trabalho e previdência social",
                "carteira profissional"
              ]
            },
            {
              "id": "aso",
              "nome": "ASO",
              "sinonimos": [
                "atestado de saúde ocupacional",
                "exame admissional",
                "atestado admissional",
                "exame médico admissional"
              ]
            },
            {
              "id": "titulo",
              "nome": "Título de eleitor",
              "sinonimos": [
                "título eleitoral",
                "e-título",
                "inscrição eleitoral"
              ],
              "obrigatorio": false
            },
            {
              "id": "banco",
              "nome": "Dados bancários",
              "sinonimos": [
                "conta salário",
                "comprovante bancário",
                "dados bancários",
                "comprovante de conta",
                "conta corrente para crédito de salário"
              ]
            }
          ]
        }
      },
      {
        "bloco": "exportar",
        "params": {
          "formatos": [
            "pdf",
            "xlsx"
          ]
        }
      }
    ],
    "output": {
      "format": "checklist",
      "files": [
        "pdf",
        "xlsx"
      ]
    },
    "review": {
      "reviewers": [
        "key_user"
      ],
      "checklist": [
        "Documentos duvidosos foram abertos e conferidos.",
        "Pendências foram comunicadas ao candidato."
      ]
    }
  }
}
