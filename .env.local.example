# Variáveis do docker-compose local. Não use estes valores em produção.
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
DATABASE_URL=postgres://greenia_srv:servidor-local@db:5432/greenia
DATABASE_OWNER_URL=postgres://postgres:dono-local@db:5432/greenia
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=sa-east-1
S3_BUCKET=greenia-documentos
S3_FORCE_PATH_STYLE=true
S3_SSE=AES256
AWS_ACCESS_KEY_ID=greenia
AWS_SECRET_ACCESS_KEY=greenia-local-123
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=GreenIA <nao-responda@greenia.local>
# Sem chave, o servidor usa o provedor simulado (só fora de produção).
ANTHROPIC_API_KEY=
USD_BRL=5.5
LOG_LEVEL=info
