{
  "nome": "Layout E · XML de registros de pedido, data dd/mm/aa, número com ponto decimal e vírgula de milhar, CNPJ formatado",
  "formato": "xml",
  "codificacao": "utf-8",
  "ignorarLinhasInicio": 0,
  "ignorarLinhasFim": 0,
  "ignorarLinhasQue": [],
  "linhaCabecalho": false,
  "caminhoRegistros": "ExportacaoPedidos.Registros.Registro",
  "numero": { "decimal": ".", "milhar": "," },
  "data": "dd/mm/aa",
  "campos": [
    { "campo": "pedido", "origem": "NumPedido", "tipo": "texto", "obrigatorio": true },
    { "campo": "dataPedido", "origem": "DtPedido", "tipo": "data", "obrigatorio": true },
    { "campo": "cnpjFornecedor", "origem": "CnpjForn", "tipo": "texto", "obrigatorio": true, "transformacoes": [{ "tipo": "somenteDigitos" }] },
    { "campo": "totalPedido", "origem": "VlrTotalPedido", "tipo": "numero" },
    { "campo": "codigo", "origem": "CodProduto", "tipo": "texto", "obrigatorio": true },
    { "campo": "descricao", "origem": "DescProduto", "tipo": "texto" },
    { "campo": "unidade", "origem": "Unid", "tipo": "texto" },
    { "campo": "quantidade", "origem": "Qtd", "tipo": "numero", "obrigatorio": true },
    { "campo": "valorUnitario", "origem": "VlrUnit", "tipo": "numero", "obrigatorio": true },
    { "campo": "valorTotal", "origem": "VlrTotal", "tipo": "numero" }
  ]
}
