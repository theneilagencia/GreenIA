{
  "nome": "Layout D · JSON de linhas de pedido em caixas (CX com 10 unidades): quantidade e preço convertidos para a unidade da nota",
  "formato": "json",
  "codificacao": "utf-8",
  "ignorarLinhasInicio": 0,
  "ignorarLinhasFim": 0,
  "ignorarLinhasQue": [],
  "linhaCabecalho": false,
  "caminhoRegistros": "dados.linhas",
  "numero": { "decimal": ".", "milhar": "" },
  "data": "aaaa-mm-dd",
  "campos": [
    { "campo": "pedido", "origem": "pedido.numero", "tipo": "texto", "obrigatorio": true },
    { "campo": "dataPedido", "origem": "pedido.data", "tipo": "data", "obrigatorio": true },
    { "campo": "cnpjFornecedor", "origem": "fornecedor.cnpj", "tipo": "texto", "obrigatorio": true },
    { "campo": "totalPedido", "origem": "pedido.valorTotal", "tipo": "numero" },
    { "campo": "codigo", "origem": "item.codigo", "tipo": "texto", "obrigatorio": true },
    { "campo": "descricao", "origem": "item.descricao", "tipo": "texto" },
    { "campo": "unidade", "origem": "embalagem", "tipo": "texto", "transformacoes": [{ "tipo": "mapear", "valores": { "CX": "UN" } }] },
    { "campo": "quantidade", "origem": "quantidade", "tipo": "numero", "obrigatorio": true, "transformacoes": [{ "tipo": "multiplicar", "fator": 10 }] },
    { "campo": "valorUnitario", "origem": "precoUnitario", "tipo": "numero", "obrigatorio": true, "transformacoes": [{ "tipo": "dividirPor", "fator": 10 }] },
    { "campo": "valorTotal", "origem": "valorTotal", "tipo": "numero" }
  ]
}
